Before:
  Save g:markdown_syntax_conceal, g:markdown_fenced_languages
  Save &conceallevel, &concealcursor
  let g:markdown_syntax_conceal = 1
  let g:markdown_fenced_languages = ['sh']
  setlocal conceallevel=2 concealcursor= syntax=markdown
  syntax sync fromstart
  redraw!
  function! WikiVisible(lnum) abort
    let visible = ''
    let col = 1
    for char in split(getline(a:lnum), '\zs')
      if !synconcealed(a:lnum, col)[0]
        let visible .= char
      endif
      let col += strlen(char)
    endfor
    return visible
  endfunction

After:
  delfunction WikiVisible
  Restore
  setlocal syntax=markdown

Given markdown;
[[Page]]
[[Folder/Page|A label]]
[[Folder/Page#Section]]
# [[Folder/Page|Heading]]
> [[Page]]
- [[Folder/Page|List item]]
[[One]][[Two]] and [standard](file.md)
**[[Folder/Page|Bold]]** and *[[Page]]*
[[Folder/Café|Café]]

Execute (wikilinks show their alias or target in ordinary inline contexts):
  let expected = ['Page', 'A label', 'Folder/Page#Section', '# Heading', '> Page',
        \ '- List item', 'OneTwo and standard', 'Bold and Page', 'Café']
  for lnum in range(1, len(expected))
    AssertEqual expected[lnum - 1], WikiVisible(lnum), 'line ' . lnum
  endfor

Given markdown;
`[[Folder/Page|Page]]`
`` [[Page]] ``

```
[[Folder/Page|Page]]
```

~~~sh
echo '[[Page]]'
~~~

    [[Folder/Page|Page]]

end

Execute (wikilink text remains literal inside code):
  AssertEqual '[[Folder/Page|Page]]', WikiVisible(1)
  AssertEqual '[[Page]]', WikiVisible(2)
  for lnum in [5, 9, 12]
    AssertEqual getline(lnum), WikiVisible(lnum), 'line ' . lnum
  endfor

Given markdown;
\[[Page]] and \[[Folder/Page|Label]]
[[missing end
[[empty|]] and [[|empty]]
[[line
break]]
plain text after

Execute (escaped or incomplete wikilinks stay visible and do not swallow later lines):
  for lnum in range(1, line('$'))
    AssertEqual getline(lnum), WikiVisible(lnum), 'line ' . lnum
  endfor

Given markdown;
[[Page]] and [[Folder/Page|Label]] and [standard](file.md)

Execute (the bundled option also disables wikilink conceal):
  let g:markdown_syntax_conceal = 0
  setlocal syntax=markdown
  syntax sync fromstart
  redraw!
  AssertEqual getline(1), WikiVisible(1)

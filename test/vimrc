set nocompatible
set nomore
let $LANG = 'en_US'

" Keep the bundled runtime in its normal place and load the add-on afterwards.
filetype off
let s:root = fnamemodify(expand('<sfile>:p'), ':h:h')
let &runtimepath = s:root . ',' . $VIMRUNTIME . ',' . s:root . '/build/tabular,'
    \ . s:root . '/build/vader.vim,' . s:root . '/build/tabular/after,' . s:root . '/after'
filetype plugin indent on
syntax enable

function! Markdown_GetScriptID(fname) abort
    for l:script in getscriptinfo()
        if l:script.name ==# s:root . '/' . a:fname
            return l:script.sid
        endif
    endfor
    throw 'Markdown test script not loaded: ' . a:fname
endfunction

function! Markdown_GetFunc(fname, funcname) abort
    return function('<SNR>' . Markdown_GetScriptID(a:fname) . '_' . a:funcname)
endfunction
